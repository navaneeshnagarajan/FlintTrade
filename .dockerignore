# =============================================================================
# FlintTrade — Docker Build Context Exclusions
# =============================================================================
# Keeps the build context small and prevents secrets from leaking into images.

# Git
.git
.gitmodules

# Environment and secrets
.env
*.env
!.env.example

# Infrastructure submodules (not needed in FlintTrade image)
infra/openalgo
infra/algomirror
infra/openclaw

# Node / Terminal (built separately by terminal service)
packages/terminal/node_modules
packages/terminal/dist
packages/terminal/.vite

# Python caches
__pycache__
*.pyc
*.pyo
.pytest_cache
.ruff_cache
.mypy_cache

# Local development
.local
.vscode
.idea
*.swp
*.swo

# Documentation
docs
*.md
!.env.example
LICENSE

# OS files
.DS_Store
Thumbs.db

# Logs and data
*.log
/data
