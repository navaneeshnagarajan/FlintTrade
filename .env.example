# FlintTrade — optional developer/server environment overrides
#
# Native desktop users do not copy or edit this file. Install the app, launch
# it, and configure brokers/OpenAlgo, LLMs, notifications, and paths from the
# Setup or Settings UI. Those choices are written to the OS workspace
# (`~/.flinttrade/`, `%APPDATA%/flinttrade/`, or
# `~/Library/Application Support/flinttrade/`).
#
# Copy this file to `.env` only for contributor dev servers, Docker/systemd
# deployments, CI experiments, or advanced self-hosting. NEVER commit `.env`.
#
# ┌────────────────────────────────────────────────────────────────────────┐
# │  NO FLINTTRADE SECRETS HERE.                                            │
# │  FlintTrade's own secrets — the credential-store master password, JWT  │
# │  signing key, API-key pepper, and TOTP install key — are NEVER read    │
# │  from the environment. They live as ACL-hardened files under           │
# │  ~/.flinttrade/ (master_password, jwt_secret, api_key_pepper,          │
# │  totp_install_key), auto-generated on first run except the master      │
# │  password, which you type at a TTY prompt (getpass) or feed via        │
# │  --master-password-fd. See flinttrade_core.secure_file.                │
# └────────────────────────────────────────────────────────────────────────┘
#
# Config tiers:
#   workspace.json  → UI-owned user config (connections, LLM, notifications)
#   ~/.flinttrade/* → hardened secret files (see banner above)
#   .env            → optional dev/server fallback only
#
# Broker credentials are configured in OpenAlgo's own .env — for the local-dev
# clone that's .local/external/openalgo/.env — not in FlintTrade.

# ============================================================
# OPTIONAL — FlintTrade backend auth
# ============================================================

# FLINTTRADE_API_KEY=        # Optional local backend API key. If omitted,
#                            # loopback-only local requests are allowed so the
#                            # app can run before OpenAlgo is configured.

# ============================================================
# OPTIONAL — OpenAlgo-compatible bridge (dev/server fallback)
# Prefer Setup → OpenAlgo Bridge or Settings → Broker Gateway in the app.
# ============================================================

# OPENALGO_HOST=
# OPENALGO_PORT=
# OPENALGO_API_KEY=
# OPENALGO_WS_PORT=

# ============================================================
# OPTIONAL — FlintTrade backend (non-secret)
# ============================================================

# FLINTTRADE_BACKEND_PORT=5100   # Flask backend port (avoids OpenAlgo 5000-5009)
# FLINTTRADE_BACKEND_HOST=127.0.0.1   # Bind host for the web surface. Set to a
#                                # tailnet IP to reach the terminal from another
#                                # machine; non-loopback binds refuse to start
#                                # until the operator account exists (or
#                                # FLINTTRADE_API_KEY is set) — loopback's
#                                # unauthenticated trust never crosses the network.
# CORS_ORIGINS=http://127.0.0.1:5173   # Comma-separated allowed origins

# ============================================================
# OPTIONAL — Data storage (defaults to ~/.flinttrade/)
# ============================================================

# DATA_DIR=
# LOG_DIR=
# AUDIT_LOG_DIR=
# TICK_DATA_DIR=

# ============================================================
# OPTIONAL — AI / LLM endpoint (dev/server fallback; prefer Settings UI)
# ============================================================

# LLM_PROVIDER=ollama
# LLM_HOST=                       # Managed Ollama ignores this; custom providers require their host
# LLM_MODEL=                       # Model id as the server reports it under /v1/models
# LLM_REASONING_MAX_TOKENS=8192    # Reasoning models (Qwen3, DeepSeek-R1) spend the token budget
#                                  # on their chain of thought; the client retries empty replies at
#                                  # this larger ceiling. Lower it only if your model never reasons.
# FLINTTRADE_RAG_ENABLED=false     # Set true to construct Chroma/sentence-transformer RAG at backend startup.
# FLINTTRADE_RAG_AUTO_INDEX=false  # Set true to enable RAG and index docs/ into Chroma at backend startup.
# Third-party LLM API keys are credentials — configure them in the Settings UI
# (they persist to the hardened workspace secret file, never workspace.json).
# Do NOT put them in .env: for a headless dev/server process, inject them as
# process-level environment variables (systemd Environment=, shell export).

# ============================================================
# OPTIONAL — Monitoring (GlitchTip sidecar; Docker/systemd only)
# ============================================================

# GLITCHTIP_DSN=             # ingest URL (not a secret)
# GlitchTip's own DB password + secret key are container secrets consumed by
# docker-compose. Set them in your private deploy .env (never committed) or,
# better, via Docker secrets:
#   GLITCHTIP_SECRET_KEY=    # python -c "import secrets; print(secrets.token_urlsafe(50))"
#   GLITCHTIP_DB_PASSWORD=   # python -c "import secrets; print(secrets.token_urlsafe(32))"

# ============================================================
# OPTIONAL — Telegram alerts
# ============================================================

# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN is a credential — prefer the Settings UI (workspace.json);
# if set here, keep it in your private .env only (never committed).

# ============================================================
# OPTIONAL — n8n workflow automation bridge
# ============================================================
# n8n is a self-hosted automation tool (like OpenAlgo/OpenClaw, an external
# optional service). The bridge surfaces in the terminal under
# Automate → n8n Bridge: health, workflow activate/deactivate, webhook trigger.

# N8N_HOST=http://127.0.0.1:5678
# N8N_API_KEY is a credential — needed only for listing/activating workflows
# (webhook triggering works without it). Keep it in your private .env only.
