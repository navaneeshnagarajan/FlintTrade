# FlintTrade — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env.
#
# This file contains ONLY infrastructure connection settings.
# User preferences (paths, modules, UI, LLM, Telegram) are in:
#   ~/.flinttrade/workspace.json
#
# Broker credentials are configured in OpenAlgo, not here.

# --- OpenAlgo connection ---
OPENALGO_HOST=
OPENALGO_PORT=
OPENALGO_API_KEY=
OPENALGO_WS_PORT=

# --- Gateway (v0.2.0+) ---
# MASTER_PASSWORD=          # Encryption key for stored broker credentials
# FLINTTRADE_PORT=5100      # Flask backend port (avoids OpenAlgo multi-instance 5000-5009)
# WS_PORT=8765              # WebSocket server port

# --- Monitoring (Glitchtip error tracking) ---
# GLITCHTIP_DSN=              # Set after first Glitchtip login
# GLITCHTIP_SECRET_KEY=       # Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
# GLITCHTIP_DB_PASSWORD=      # Required. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- CORS ---
# CORS_ORIGINS=http://127.0.0.1:5173   # Comma-separated allowed origins
