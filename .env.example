# FlintTrade — optional developer/server environment overrides
#
# Native desktop users do not copy or edit this file. Install the app, launch
# it, and configure brokers/OpenAlgo, LLMs, notifications, and paths from the
# Setup or Settings UI. Those choices are written to the OS workspace
# (`~/.flinttrade/`, `%APPDATA%/flinttrade/`, or
# `~/Library/Application Support/flinttrade/`).
#
# Copy this file to `.env` only for contributor dev servers, Docker/systemd
# deployments, CI experiments, or advanced self-hosting. NEVER commit `.env`.
#
# ┌────────────────────────────────────────────────────────────────────────┐
# │  NO FLINTTRADE SECRETS HERE.                                            │
# │  FlintTrade's own secrets — the credential-store master password, JWT  │
# │  signing key, API-key pepper, and TOTP install key — are NEVER read    │
# │  from the environment. They live as ACL-hardened files under the       │
# │  platform workspace dir (see docs/setup/backup.md):                    │
# │    Linux   ~/.flinttrade/                                              │
# │    macOS   ~/Library/Application Support/flinttrade/                   │
# │    Windows %APPDATA%/flinttrade/                                       │
# │  Filenames: master_password, jwt_secret, api_key_pepper,               │
# │  totp_install_key. Auto-generated on first run except the master       │
# │  password, which you type at a TTY prompt (getpass) or feed via        │
# │  --master-password-fd. See flinttrade_core.secure_file.                │
# └────────────────────────────────────────────────────────────────────────┘
#
# Config tiers:
#   workspace.json  → UI-owned user config (connections, LLM, notifications)
#   <workspace>/*   → hardened secret files (platform dir above)
#   .env            → optional dev/server fallback only
#
# Broker credentials are configured in OpenAlgo's own .env — for the local-dev
# clone that's .local/external/openalgo/.env — not in FlintTrade.

# ============================================================
# OPTIONAL — FlintTrade backend auth
# ============================================================

# FLINTTRADE_API_KEY=        # Optional local backend API key. If omitted,
#                            # loopback-only local requests are allowed so the
#                            # app can run before OpenAlgo is configured.

# ============================================================
# OPTIONAL — OpenAlgo-compatible bridge (dev/server fallback)
# Prefer Setup → OpenAlgo Bridge or Settings → Broker Gateway in the app.
# ============================================================

# OPENALGO_HOST=
# OPENALGO_PORT=
# OPENALGO_API_KEY=
# OPENALGO_WS_PORT=

# ============================================================
# OPTIONAL — FlintTrade backend (non-secret)
# ============================================================

# FLINTTRADE_BACKEND_PORT=5100   # Flask backend port (avoids OpenAlgo 5000-5009)
# FLINTTRADE_BACKEND_HOST=127.0.0.1   # Bind host for the web surface. Set to a
#                                # tailnet IP to reach the terminal from another
#                                # machine; non-loopback binds refuse to start
#                                # until the operator account exists (or
#                                # FLINTTRADE_API_KEY is set) — loopback's
#                                # unauthenticated trust never crosses the network.
# CORS_ORIGINS=http://127.0.0.1:5173   # Comma-separated allowed origins

# ============================================================
# OPTIONAL — Data storage overrides
# Defaults follow the platform workspace dir (see banner), not
# unconditionally ~/.flinttrade/.
# ============================================================

# AUDIT_LOG_DIR=          # Backend override for the audit-log directory.
# DATA_DIR=               # Redirects Ditto account metadata only
#                         # (<DATA_DIR>/ditto_accounts.sqlite). Not a general
#                         # workspace-root override — use FLINTTRADE_WORKSPACE_DIR.
# LOG_DIR=                # Used by infra/scripts/setup.sh only; ignored by
#                         # flinttrade_core.app.
# TICK_DATA_DIR=          # Same: setup.sh installer only, not the backend.

# ============================================================
# OPTIONAL — AI / LLM endpoint (dev/server fallback; prefer Settings UI)
# ============================================================

# LLM_PROVIDER=ollama
# LLM_HOST=                       # Managed Ollama ignores this; custom providers require their host
# LLM_MODEL=                       # Model id as the server reports it under /v1/models
# LLM_REASONING_MAX_TOKENS=8192    # Reasoning models (Qwen3, DeepSeek-R1) spend the token budget
#                                  # on their chain of thought; the client retries empty replies at
#                                  # this larger ceiling. Lower it only if your model never reasons.
# FLINTTRADE_RAG_ENABLED=false     # Set true to construct the local SQLite/NumPy RAG runtime at backend startup.
# FLINTTRADE_RAG_AUTO_INDEX=false  # Set true to enable RAG and index docs/ into the local vector store at startup.
# Third-party LLM API keys are credentials — configure them in the Settings UI
# (they persist to the hardened workspace secret file, never workspace.json).
# Do NOT put them in .env: for a headless dev/server process, inject them as
# process-level environment variables (systemd Environment=, shell export).

# ============================================================
# OPTIONAL — Docker deployment (docker compose)
# ============================================================

# Host ports Nginx (the Docker UI origin) publishes. Defaults are high ports so
# a machine with a busy :80/:443 still comes up; production hosts set 80/443.
# FLINTTRADE_HTTP_PORT=8080
# FLINTTRADE_HTTPS_PORT=8443

# ============================================================
# OPTIONAL — Monitoring (GlitchTip sidecar; Docker/systemd only)
# Started only by the Docker monitoring profile:
#   docker compose --profile monitoring up -d
# ============================================================

# GLITCHTIP_DSN=             # ingest URL (not a secret)
# GlitchTip's own DB password + secret key are container secrets consumed by
# docker-compose. The values below are DEV-ONLY placeholders that match the
# defaults baked into docker-compose.yml — the monitoring profile requires
# REAL values here (in your private, never-committed .env) or, better,
# Docker secrets. Never run the monitoring profile with these placeholders
# on a host anyone else can reach.
# Generate real values with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"   (secret key)
#   python -c "import secrets; print(secrets.token_urlsafe(32))"   (db password)
# Keep these assignments comment-free: the Makefile `include`s + `export`s this
# file, and GNU make would export an inline comment's leading whitespace as
# part of the value.
GLITCHTIP_SECRET_KEY=flinttrade-dev-only-change-me
GLITCHTIP_DB_PASSWORD=flinttrade-dev-only-change-me

# ============================================================
# OPTIONAL — Telegram alerts
# ============================================================

# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN is a credential — prefer Settings → Telegram. The token
# is stored under <workspace>/secrets/; workspace.json holds only a secret://
# reference. If you set the token here instead, keep it in your private .env
# only (never committed).

# ============================================================
# OPTIONAL — password-recovery email (SMTP or Amazon SES)
# Used by EmailTransport for Welcome Forgot-password OTP
# (POST /v1/auth/forgot-password-otp). A local-only install can
# omit these; reset email will not send until one transport is
# configured. See docs/setup/email.md.
# SMTP_PASSWORD is a mailbox credential — keep it in your private
# .env only (never committed). FlintTrade's own secrets still live
# under the workspace dir (see banner), not here.
# SES is tried first when AWS_SES_REGION or AWS_DEFAULT_REGION is set.
# ============================================================

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# AWS_SES_REGION=
# AWS_DEFAULT_REGION=
