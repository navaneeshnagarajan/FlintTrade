# FlintTrade — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env.
#
# Two-tier config:
#   .env            → Infrastructure (connections, ports, paths)
#   workspace.json  → User preferences (UI, LLM, Telegram, modules)
#
# Broker credentials are configured in OpenAlgo (infra/openalgo/.env), not here.

# ============================================================
# REQUIRED — OpenAlgo connection
# ============================================================

OPENALGO_HOST=
OPENALGO_PORT=
OPENALGO_API_KEY=
OPENALGO_WS_PORT=

# ============================================================
# OPTIONAL — FlintTrade backend
# ============================================================

# FLINTTRADE_PORT=5100      # Flask backend port (avoids OpenAlgo 5000-5009)
# MASTER_PASSWORD=          # Encryption key for stored broker credentials
# CORS_ORIGINS=http://127.0.0.1:5173   # Comma-separated allowed origins

# ============================================================
# OPTIONAL — Data storage (defaults to ~/.flinttrade/)
# ============================================================

# DATA_DIR=
# LOG_DIR=
# AUDIT_LOG_DIR=
# DUCKDB_PATH=
# TICK_DATA_DIR=

# ============================================================
# OPTIONAL — AI / LLM (also configurable in workspace.json)
# ============================================================

# LLM_PROVIDER=lmstudio
# LLM_HOST=http://127.0.0.1:1234
# LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ============================================================
# OPTIONAL — Monitoring
# ============================================================

# GLITCHTIP_DSN=
# GLITCHTIP_SECRET_KEY=     # Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
# GLITCHTIP_DB_PASSWORD=    # Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ============================================================
# OPTIONAL — Telegram alerts
# ============================================================

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=false

# ============================================================
# OPTIONAL — SEBI compliance
# ============================================================

# SEBI_MAX_OPS=10
# SEBI_AUDIT_RETENTION_YEARS=5

# ============================================================
# OPTIONAL — Security (generated automatically if unset)
# ============================================================

# FLINTTRADE_TOTP_KEY=      # Master key for encrypting TOTP secrets.
                            # If unset, a per-install random key is generated
                            # at ~/.flinttrade/totp_install_key on first run.
                            # Set explicitly for multi-node deployments.
# JWT_SECRET=               # 32+ byte HMAC key for JWT signing.
                            # If unset, auto-generated at ~/.flinttrade/jwt_secret.
