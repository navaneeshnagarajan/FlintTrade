# ============================================================
# FlintTrade Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env.
# ============================================================

# --- OpenAlgo (managed by FlintTrade, runs on port 5000) ---
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_API_KEY=
OPENALGO_WS_PORT=8765
OPENALGO_ZMQ_PORT=5555

# --- Broker (configured in OpenAlgo, referenced here) ---
BROKER=
BROKER_CLIENT_ID=
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_TOTP_SECRET=

# --- FlintTrade Data Storage ---
DATA_DIR=/data/flinttrade
LOG_DIR=/var/log/flinttrade
AUDIT_LOG_DIR=/data/flinttrade/audit
DUCKDB_PATH=/data/flinttrade/flint.duckdb
TICK_DATA_DIR=/data/flinttrade/ticks

# --- AI / LLM ---
LLM_PROVIDER=
LLM_HOST=http://127.0.0.1:1234
LLM_MODEL=
LLM_CONTEXT_LENGTH=32768
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- OpenClaw (AI agent gateway) ---
OPENCLAW_PORT=18789
OPENCLAW_AUTH_TOKEN=
OPENCLAW_MODEL=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- WireGuard VPN ---
WIREGUARD_ENABLED=false
WIREGUARD_SERVER_IP=
WIREGUARD_PORT=51820

# --- DDNS ---
DDNS_HOSTNAME=
DDNS_PROVIDER=
DDNS_USERNAME=
DDNS_PASSWORD=

# --- Network (dual WAN) ---
WAN_PRIMARY_IP=
WAN_FAILOVER_IP=

# --- Blue-Green (optional) ---
BLUE_GREEN_ENABLED=false
OPENALGO_BLUE_PORT=5001
OPENALGO_GREEN_PORT=5002
ACTIVE_COLOR=blue

# --- SEBI Compliance ---
SEBI_MAX_OPS=10
SEBI_AUDIT_RETENTION_YEARS=5
SEBI_STATIC_IP_REQUIRED=true

# --- Feature Flags ---
ENABLE_BACKTEST=true
ENABLE_AI=true

# --- Machine Identity ---
MACHINE_NAME=
MACHINE_ROLE=
CONTRIBUTOR_USERNAME=
