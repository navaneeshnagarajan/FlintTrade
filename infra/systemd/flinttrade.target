# =============================================================================
# FlintTrade Target — starts all FlintTrade services together
# =============================================================================
#
# Groups FlintTrade backend services into a single manageable unit.
#
# USAGE:
#   sudo systemctl enable flinttrade.target
#   sudo systemctl start flinttrade.target     # starts FlintTrade backend
#   sudo systemctl stop flinttrade.target      # stops FlintTrade backend
#   sudo systemctl status flinttrade.target    # check grouped status
#
# INSTALL:
#   sudo cp flinttrade.target /etc/systemd/system/
#   sudo systemctl daemon-reload
# =============================================================================

[Unit]
Description=FlintTrade Platform
Documentation=https://github.com/navaneeshnagarajan/FlintTrade
After=network.target
Wants=flinttrade.service

[Install]
WantedBy=multi-user.target
