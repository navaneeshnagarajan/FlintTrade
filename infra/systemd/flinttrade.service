# =============================================================================
# FlintTrade Backend Service — systemd unit
# =============================================================================
#
# Platform backend: strategy engine, screener, AI, data pipelines.
# Binds to 127.0.0.1:5100 (Nginx reverse-proxies /ft-api/ to this).
#
# INSTALL:
#   1. sudo cp flinttrade.service /etc/systemd/system/
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable flinttrade
#   4. sudo systemctl start flinttrade
#
# LOGS:    journalctl -u flinttrade -f
# STATUS:  sudo systemctl status flinttrade
# RESTART: sudo systemctl restart flinttrade
# =============================================================================

[Unit]
Description=FlintTrade Backend (strategy engine, screener, AI)
Documentation=https://github.com/navaneeshnagarajan/FlintTrade
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/flinttrade

# Environment — constrain numerical library threads to avoid CPU contention
Environment=OPENBLAS_NUM_THREADS=2
Environment=OMP_NUM_THREADS=2
Environment=FLINTTRADE_DEV=0
Environment=FLINTTRADE_HOME=/opt/flinttrade
Environment=FLINTTRADE_PORT=5100
Environment=PYTHONPATH=/opt/flinttrade/packages/core/core/src
EnvironmentFile=/opt/flinttrade/.env

# Gunicorn with eventlet — single worker for WebSocket compatibility
ExecStart=/opt/flinttrade/.venv/bin/gunicorn \
    --worker-class eventlet \
    -w 1 \
    --bind 127.0.0.1:5100 \
    --timeout 120 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile - \
    'flinttrade_core.app:app'

# Restart policy — always restart with a brief cooldown
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/flinttrade/data /opt/flinttrade/.flinttrade
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flinttrade

[Install]
WantedBy=multi-user.target
