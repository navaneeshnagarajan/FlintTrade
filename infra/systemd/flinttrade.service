# =============================================================================
# FlintTrade Backend Service — systemd unit
# =============================================================================
#
# Platform backend: strategy engine, screener, AI, data pipelines.
# Binds to 127.0.0.1:5100 (Nginx reverse-proxies /ft-api/ to this).
#
# INSTALL:
#   1. sudo cp flinttrade.service /etc/systemd/system/
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable flinttrade
#   4. sudo systemctl start flinttrade
#
# LOGS:    journalctl -u flinttrade -f
# STATUS:  sudo systemctl status flinttrade
# RESTART: sudo systemctl restart flinttrade
# =============================================================================

[Unit]
Description=FlintTrade Backend (strategy engine, screener, AI)
Documentation=https://github.com/navaneeshnagarajan/FlintTrade
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/flinttrade

# Environment — constrain numerical library threads to avoid CPU contention
Environment=OPENBLAS_NUM_THREADS=2
Environment=OMP_NUM_THREADS=2
Environment=FLINTTRADE_DEV=0
Environment=FLINTTRADE_HOME=/opt/flinttrade
Environment=FLINTTRADE_WORKSPACE_DIR=/opt/flinttrade/.flinttrade
Environment=FLINTTRADE_BACKEND_PORT=5100
Environment=PYTHONPATH=/opt/flinttrade/packages/core/core/src:/opt/flinttrade/packages/core/data/src:/opt/flinttrade/packages/core/historical/src:/opt/flinttrade/packages/core/indicators/src:/opt/flinttrade/packages/integrations/gateway/src:/opt/flinttrade/packages/integrations/webhooks/src:/opt/flinttrade/packages/services/ai/src:/opt/flinttrade/packages/services/automation/src:/opt/flinttrade/packages/services/backtest/src:/opt/flinttrade/packages/services/ditto/src:/opt/flinttrade/packages/services/engine/src:/opt/flinttrade/packages/services/journal/src:/opt/flinttrade/packages/services/screener/src
EnvironmentFile=/opt/flinttrade/.env

# Same module as scripts/ft.py and infra/install/install-native.sh.
ExecStart=/opt/flinttrade/.venv/bin/python -m flinttrade_core.app

# Restart policy — always restart with a brief cooldown
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/flinttrade/data /opt/flinttrade/.flinttrade
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flinttrade

[Install]
WantedBy=multi-user.target
