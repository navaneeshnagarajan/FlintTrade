{
  "name": "@flinttrade/site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:content",
    "dev": "next dev --port 3000",
    "prebuild": "npm run generate:content && npm run generate:demo",
    "build": "next build --webpack && node scripts/audit-scroll-world-bundle.mjs",
    "start": "next start",
    "pretypecheck": "npm run generate:content",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:content",
    "test": "vitest run",
    "generate:content": "node scripts/generate-content.mjs && fumadocs-mdx",
    "mcp:stdio": "node scripts/generate-content.mjs >/dev/null && tsx src/mcp/stdio.ts",
    "generate:demo": "node scripts/generate-demo.mjs"
  },
  "dependencies": {
    "@flinttrade/design-system": "file:../../core/design-system",
    "@modelcontextprotocol/server": "2.3.1",
    "@vercel/speed-insights": "2.0.0",
    "fumadocs-core": "16.17.1",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "16.17.1",
    "geist": "1.7.2",
    "lucide-react": "1.57.0",
    "mcp-handler": "2.3.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
