{
  "name": "@flinttrade/site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:content",
    "dev": "next dev --port 3000",
    "prebuild": "npm run generate:content && npm run generate:demo",
    "build": "next build --webpack && node scripts/audit-scroll-world-bundle.mjs",
    "start": "next start",
    "pretypecheck": "npm run generate:content",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:content",
    "test": "vitest run",
    "generate:content": "node scripts/generate-content.mjs && fumadocs-mdx",
    "mcp:stdio": "node scripts/generate-content.mjs >/dev/null && tsx src/mcp/stdio.ts",
    "generate:demo": "node scripts/generate-demo.mjs"
  },
  "dependencies": {
    "@flinttrade/design-system": "file:../../core/design-system",
    "@modelcontextprotocol/server": "2.1.0",
    "@vercel/speed-insights": "^2.0.0",
    "fumadocs-core": "^16.13.0",
    "fumadocs-mdx": "^15.2.1",
    "fumadocs-ui": "^16.13.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "mcp-handler": "2.2.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
