{
  "name": "@flinttrade/site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:content",
    "dev": "next dev --port 3000",
    "prebuild": "npm run generate:content && npm run generate:demo",
    "build": "next build --webpack",
    "pretypecheck": "npm run generate:content",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:content",
    "test": "vitest run",
    "generate:content": "node scripts/generate-content.mjs && fumadocs-mdx",
    "mcp:stdio": "node scripts/generate-content.mjs >/dev/null && tsx src/mcp/stdio.ts",
    "generate:demo": "node scripts/generate-demo.mjs"
  },
  "dependencies": {
    "@flinttrade/design-system": "file:../../core/design-system",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@vercel/speed-insights": "^2.0.0",
    "fumadocs-core": "^16.8.12",
    "fumadocs-mdx": "^15.0.7",
    "fumadocs-ui": "^16.8.12",
    "geist": "^1.7.0",
    "lucide-react": "^0.577.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
