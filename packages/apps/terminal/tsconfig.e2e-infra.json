{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "@playwright/test"
    ]
  },
  "include": [
    "playwright.incidents.config.ts",
    "playwright.policy.config.ts",
    "e2e/incidents/SystemIncidents.spec.ts",
    "e2e/incidents/vite.config.ts",
    "playwright.config.ts",
    "playwright.infra.config.ts",
    "playwright.public-demo.config.ts",
    "playwright.visual.config.ts",
    "playwright.order-flow.config.ts",
    "playwright.reticle.config.ts",
    "vite.reticle.config.ts",
    "e2e/foundation-transport-failure.spec.ts",
    "e2e/foundation-truth-fixtures.ts",
    "e2e/foundation-truth.spec.ts",
    "e2e/order-flow-fixtures.ts",
    "e2e/order-flow-presentation.spec.ts",
    "e2e/notification-disclosure.spec.ts",
    "e2e/operator-error-fixtures.ts",
    "e2e/operator-error.spec.ts",
    "e2e/positions-compact-height.spec.ts",
    "e2e/compact-startup-phase.spec.ts",
    "e2e/indstocks-disclosure-fixtures.ts",
    "e2e/indstocks-disclosure.spec.ts",
    "e2e/account-action-retry.spec.ts",
    "e2e/shared-core-integrated.spec.ts",
    "e2e/run-policy-integrated.spec.ts",
    "e2e/run-policy-core-fixture.ts",
    "e2e/run-policy-remaining.spec.ts",
    "e2e/run-policy-negative-seams.ts",
    "e2e/run-policy-negative-seams.spec.ts",
    "e2e/schema-csp.spec.ts",
    "e2e/fixture-registry.ts",
    "e2e/about-versions.spec.ts",
    "e2e/infra-self-tests.spec.ts",
    "e2e/workspace-lifecycle.spec.ts",
    "e2e/public-demo-presets.spec.ts",
    "e2e/start-public-demo.ts",
    "e2e/order-pad-practice.spec.ts",
    "e2e/agent-practice.spec.ts",
    "e2e/learn-ai-polish.spec.ts",
    "e2e/visual-a11y.spec.ts",
    "e2e/visual/support.ts",
    "e2e/visual/desk-mocks.ts",
    "playwright.csp.config.ts",
    "e2e/csp/schema-probe.ts",
    "e2e/accessibility-overflow.spec.ts",
    "e2e/structural-accessibility.spec.ts",
    "e2e/structural-accessibility.ts",
    "e2e/workspace-interactions.ts",
    "e2e/observed-registry.ts"
  ]
}
