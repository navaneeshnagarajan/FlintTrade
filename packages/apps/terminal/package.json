{
  "name": "@flinttrade/terminal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.css"
  ],
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "npm run test:base && npm run test:widgets:analysis && npm run test:widgets:trading && npm run test:widgets:utility",
    "test:vitest": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=${VITEST_HEAP_MB:-4096}\" vitest run",
    "test:base": "npm run test:vitest -- src/__tests__ src/admin src/atoms src/chrome src/components src/hooks src/layout src/lib src/providers src/routes src/services src/stores src/test-utils src/tools",
    "test:widgets:analysis": "npm run test:vitest -- src/widgets/analysis",
    "test:widgets:trading": "npm run test:vitest -- src/widgets/trading src/widgets/orders src/widgets/account",
    "test:widgets:utility": "npm run test:vitest -- src/widgets/utility",
    "e2e": "playwright test",
    "e2e:infra": "playwright test --config=playwright.infra.config.ts --project=chromium --workers=1 --retries=0",
    "e2e:public-demo": "playwright test --config=playwright.public-demo.config.ts --project=chromium --workers=1 --retries=0",
    "e2e:infra:typecheck": "tsc --project tsconfig.e2e-infra.json --noEmit",
    "e2e:infra:lint": "eslint e2e/order-flow-fixtures.ts e2e/order-flow-presentation.spec.ts e2e/operator-error-fixtures.ts e2e/operator-error.spec.ts e2e/positions-compact-height.spec.ts e2e/compact-startup-phase.spec.ts e2e/indstocks-disclosure-fixtures.ts e2e/indstocks-disclosure.spec.ts e2e/account-action-retry.spec.ts playwright.order-flow.config.ts e2e/fixture-registry.ts e2e/about-versions.spec.ts e2e/infra-self-tests.spec.ts e2e/workspace-lifecycle.spec.ts e2e/public-demo-presets.spec.ts e2e/start-public-demo.ts e2e/order-pad-practice.spec.ts e2e/agent-practice.spec.ts e2e/learn-ai-polish.spec.ts e2e/visual-a11y.spec.ts e2e/visual/support.ts e2e/visual/desk-mocks.ts playwright.config.ts playwright.infra.config.ts playwright.public-demo.config.ts playwright.visual.config.ts --max-warnings=0",
    "e2e:visual": "playwright test --config=playwright.visual.config.ts --project=chromium --workers=1 --retries=0",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@finos/fdc3": "2.2.3",
    "@finos/perspective": "3.8.0",
    "@finos/perspective-viewer": "3.8.0",
    "@finos/perspective-viewer-datagrid": "3.8.0",
    "@flinttrade/design-system": "file:../../core/design-system",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@hookform/resolvers": "^5.9.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "flexlayout-react": "^0.11.1",
    "framer-motion": "^14.0.0",
    "geist": "^1.7.2",
    "jotai": "^3.0.1",
    "lightweight-charts": "^5.2.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.52.0",
    "plotly.js": "^4.1.2",
    "plotly.js-dist-min": "^4.1.2",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.2",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "8.0.6",
    "@playwright/test": "^1.63.0",
    "@reticlehq/react": "3.5.0",
    "@reticlehq/vite-plugin": "3.5.0",
    "@sentry/react": "^11.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^30.1.2",
    "mapbox-gl": "^1.13.3",
    "marked": "^18.1.0",
    "react-responsive-carousel": "^3.2.23",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
