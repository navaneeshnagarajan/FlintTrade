{
  "name": "@flinttrade/terminal",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/index.css"
  ],
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:base && npm run test:widgets:analysis && npm run test:widgets:trading && npm run test:widgets:utility",
    "test:vitest": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=${VITEST_HEAP_MB:-4096}\" vitest run",
    "test:base": "npm run test:vitest -- src/__tests__ src/admin src/atoms src/chrome src/components src/hooks src/layout src/lib src/providers src/routes src/services src/stores src/test-utils src/tools",
    "test:widgets:analysis": "npm run test:vitest -- src/widgets/analysis",
    "test:widgets:trading": "npm run test:vitest -- src/widgets/trading src/widgets/orders src/widgets/account",
    "test:widgets:utility": "npm run test:vitest -- src/widgets/utility",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "@finos/fdc3": "2.2.3",
    "@finos/perspective": "3.8.0",
    "@finos/perspective-viewer": "3.8.0",
    "@finos/perspective-viewer-datagrid": "3.8.0",
    "@flinttrade/design-system": "file:../../core/design-system",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@hookform/resolvers": "^5.5.7",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "flexlayout-react": "^0.10.1",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "jotai": "^2.20.2",
    "lightweight-charts": "^5.0.0",
    "lightweight-charts-indicators": "^0.5.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.577.0",
    "oakscriptjs": "^0.5.0",
    "plotly.js": "^3.7.0",
    "plotly.js-dist-min": "^3.7.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.82.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sentry/react": "^8.55.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.0",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^29.0.0",
    "mapbox-gl": "^1.13.3",
    "marked": "^17.0.5",
    "react-responsive-carousel": "^3.2.23",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
