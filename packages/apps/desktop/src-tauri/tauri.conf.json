{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlintTrade",
  "version": "0.6.0-beta.11",
  "identifier": "com.flinttrade.app",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "FlintTrade",
        "width": 460,
        "height": 320,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default", "main-remote"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCMTVBMDNDQ0UwQTcwMQpSV1FCcCtETUExcXhBamdyVk53NFZZOFR0d2NDZEZJTGM5NmFXaXlObUVnbk5DWml1eFh4dnFYSQo=",
      "endpoints": [
        "https://github.com/navaneeshnagarajan/FlintTrade/releases/download/updater-beta/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Open-source self-hosted trading software.",
    "longDescription": "FlintTrade is open-source, native-first trading software for manual, automated, algorithmic, and AI-assisted workflows. The desktop app is a thin shell: on first run it downloads the hash-verified FlintTrade backend (which embeds the terminal) and serves everything from one local application — no separate server to run.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../../scripts/install/flinttrade-install.sh": "scripts/install/flinttrade-install.sh",
      "../../../../scripts/install/flinttrade-install.ps1": "scripts/install/flinttrade-install.ps1"
    },
    "copyright": "Copyright © FlintTrade contributors. Licensed AGPL-3.0.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "librsvg2"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
