# Rust / Tauri build output
src-tauri/target/

# Tauri-generated schemas + capabilities manifests (regenerated by tauri-build)
src-tauri/gen/

# Frozen backend sidecar — a build artifact produced by packaging/build-backend.sh.
# Large (100+ MB) and platform-specific; never committed.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# Staged installers
dist-installers/

# Node
node_modules/

# The root .gitignore's macOS custom-folder-icon rule ("Icon?") also matches
# this "icons" directory by accident (? matches the trailing "s"). Force-include
# the real Tauri app icons — `tauri build` / generate_context! require them.
!src-tauri/icons/
!src-tauri/icons/**
