{
  "name": "@flinttrade/design-system",
  "version": "0.6.0-alpha",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "sideEffects": [
    "*.css",
    "./src/index.css",
    "./src/tokens.css",
    "./src/glass.css",
    "./src/cinematic.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./glass.css": "./src/glass.css",
    "./cinematic.css": "./src/cinematic.css",
    "./components": "./src/components/index.ts",
