    "./motion": "./src/motion/index.ts",
    "./tailwind-preset": "./src/tailwind-preset.ts",
    "./lib/*": "./src/lib/*.ts",
    "./themes/presets": "./src/themes/presets.ts",
    "./themes/cinematic": "./src/themes/cinematic.ts",
    "./themes/dark-only": "./src/themes/dark-only.ts",
    "./brand": "./src/brand/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./forms": "./src/forms/index.ts",
    "./chart-theme": "./src/chart-theme/index.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
