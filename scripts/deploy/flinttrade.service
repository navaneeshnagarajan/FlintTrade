[Unit]
Description=FlintTrade Backend (Python)
Documentation=https://github.com/navaneeshnagarajan/FlintTrade
After=network.target
Wants=network.target

[Service]
Type=simple
User={{FLINTTRADE_USER}}
Group={{FLINTTRADE_USER}}
WorkingDirectory={{INSTALL_DIR}}
EnvironmentFile={{INSTALL_DIR}}/.env
ExecStart={{INSTALL_DIR}}/.venv/bin/python -m uvicorn packages.core.src.app:create_app --host 0.0.0.0 --port {{BACKEND_PORT}} --workers 2
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flinttrade

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths={{INSTALL_DIR}} /home/{{FLINTTRADE_USER}}/.flinttrade

[Install]
WantedBy=multi-user.target
