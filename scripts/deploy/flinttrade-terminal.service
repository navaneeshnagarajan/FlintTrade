[Unit]
Description=FlintTrade Terminal (Node/Vite preview)
Documentation=https://github.com/navaneeshnagarajan/FlintTrade
After=network.target flinttrade.service
Wants=network.target

[Service]
Type=simple
User={{FLINTTRADE_USER}}
Group={{FLINTTRADE_USER}}
WorkingDirectory={{INSTALL_DIR}}/packages/terminal
Environment=NODE_ENV=production
Environment=PORT={{TERMINAL_PORT}}
ExecStart=/usr/bin/node node_modules/.bin/vite preview --host 0.0.0.0 --port {{TERMINAL_PORT}}
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flinttrade-terminal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths={{INSTALL_DIR}}/packages/terminal

[Install]
WantedBy=multi-user.target
